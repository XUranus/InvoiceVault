{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "InvoiceVault",
  "version": "0.1.0",
  "identifier": "com.invoicevault.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "InvoiceVault",
        "width": 1024,
        "height": 680,
        "minWidth": 860,
        "minHeight": 560
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": ["../icons/app.png"]
  }
}
